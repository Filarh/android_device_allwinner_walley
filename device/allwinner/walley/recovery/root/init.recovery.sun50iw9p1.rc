# Control remoto infrarrojo en el recovery.
#
# Copiado del init.recovery.sun50iw9p1.rc de fabrica, que YA hacia esto: el
# recovery stock maneja el mando. El binario es el del recovery (20332 bytes),
# no el de /system (34740): no usa binder y solo pide las siete librerias
# estandar, que TWRP ya tiene.
#
# OJO CON EL seclabel: el original es u:r:multi_ir:s0, un dominio que solo
# existe en la politica de fabrica. En TWRP hay que usar uno que su politica
# tenga (recovery, o su) o el servicio no arranca y el mando no responde.
service multi_ir /system/bin/multi_ir
    user system
    group system input uhid
    seclabel u:r:recovery:s0

on boot
    start multi_ir

# ADB por red dentro de TWRP.
#
# adbd lee service.adb.tcp.port al arrancar: con un puerto puesto escucha por
# TCP en vez de por USB. La caja no tiene nada enchufado al USB y toda la
# cirugia se hace por LAN, asi que sin esto el recovery es una caja negra --
# comprobado: tras flashear TWRP se perdio el contacto y solo quedaba mirar la
# tele para saber si habia arrancado.
#
# La interfaz la levanta el kernel con el parametro ip= de BOARD_KERNEL_CMDLINE,
# no hace falta ningun servicio de red aca.
#
# Va en 'on boot' y no mas tarde porque adbd tiene que ver la propiedad ya
# puesta cuando arranca; si se pone despues hay que reiniciarlo a mano.
on init
    setprop service.adb.tcp.port 5555

on property:sys.boot_completed=1
    setprop service.adb.tcp.port 5555
